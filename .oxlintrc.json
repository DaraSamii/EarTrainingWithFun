{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Arcade engines keep mutable game state for their rAF loops and re-render on demand (ADR-016)
      "files": ["src/features/arcade/**"],
      "rules": { "react/immutability": "off", "react/refs": "off", "react/purity": "off" }
    }
  ]
}
